{
  "name": "zine-publications-verification",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "staging",
    "APNS_ENABLED": "true",
    "APNS_TOPIC": "app.zine.native",
    "ARTICLE_BODY_PIPELINE_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zine-publications-verification",
      "database_id": "6ccc7d79-81a0-417e-a94b-785303d0b1c4",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_CONTENT",
      "bucket_name": "zine-publications-verification",
    },
    {
      "binding": "PUBLICATION_MEDIA",
      "bucket_name": "zine-publications-verification",
    },
  ],
  "images": {
    "binding": "PUBLICATION_IMAGES",
  },
}

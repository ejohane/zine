{
  "$schema": "https://unpkg.com/wrangler@4.158.0/config-schema.json",
  "name": "zine-next-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "account_id": "887513bb1f71a8ef2029e2f9bd3086b2",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api-next.myzine.app/next*", "zone_name": "myzine.app" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": { "enabled": true },
}

{
  "$schema": "https://unpkg.com/wrangler@4.158.0/config-schema.json",
  "name": "zine-api-next",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": { "binding": "DEPLOYMENT" },
  "routes": [{ "pattern": "api-next.myzine.app", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "preview",
    "AUTH_ISSUER": "https://clerk.myzine.app",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubXl6aW5lLmFwcCQ",
    "AUTH_AUDIENCE": "",
    "AUTH_AUTHORIZED_PARTIES": "https://api-next.myzine.app",
    "ALLOWED_ORIGINS": "https://api-next.myzine.app,http://localhost:8890",
    "EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zine-api-next",
      "database_id": "0e55836b-07de-426b-9977-b783b0ea6652",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "zine-api-next-artifacts" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "zine-api-next-vectors" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "zine-api-next-jobs" }],
    "consumers": [
      {
        "queue": "zine-api-next-jobs",
        "max_batch_size": 5,
        "max_concurrency": 8,
        "max_retries": 5,
        "dead_letter_queue": "zine-api-next-dead",
      },
    ],
  },
  "triggers": { "crons": ["*/5 * * * *"] },
}

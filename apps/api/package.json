{
  "name": "@zine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler@4.158.0 dev --port 8890",
    "build": "bunx wrangler@4.158.0 deploy --dry-run --outdir .wrangler/build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint src test scripts client verification",
    "test": "vitest run",
    "db:migrate:local": "bunx wrangler@4.158.0 d1 migrations apply DB --local",
    "deploy": "bunx wrangler@4.158.0 deploy",
    "cli": "bun run scripts/zine.ts",
    "doctor": "bun run scripts/doctor.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.3.6",
    "hono": "^4.12.0",
    "jose": "^6.1.0",
    "linkedom": "^0.18.12",
    "zod4": "npm:zod@4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "esbuild": "^0.27.3",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.9"
  }
}
